# deltaIndices or differenced Indices are computed from the difference b/w pre-fire and post-fire images
# includes visualization and export to drive


import ee
import geemap

# Authenticate and initialize GEE
ee.Authenticate()
ee.Initialize(project='ee-projectid')

# Define AOI
AOI8 = ee.FeatureCollection('projects/ee-projectid/assets/aoi_assetid')

# Function to mask clouds using Sentinel-2 QA60 band
def maskS2clouds(image):
    qa = image.select('QA60')
    cloudBitMask = 1 << 10
    cirrusBitMask = 1 << 11
    mask = qa.bitwiseAnd(cloudBitMask).eq(0).And(qa.bitwiseAnd(cirrusBitMask).eq(0))
    return image.updateMask(mask)

# Define Pre-fire and Post-fire Dates
preFireStart = '2019-03-02'
preFireEnd = '2019-03-05'
postFireStart = '2019-04-15'
postFireEnd = '2019-04-19'

# Load Pre-fire and Post-fire Sentinel-2 images
preFireImage = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') \
    .filterBounds(AOI8) \
    .filterDate(preFireStart, preFireEnd) \
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20)) \
    .map(maskS2clouds)

postFireImage = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') \
    .filterBounds(AOI8) \
    .filterDate(postFireStart, postFireEnd) \
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20)) \
    .map(maskS2clouds)

# Check if images exist
if preFireImage.getInfo() is None or postFireImage.getInfo() is None:
    raise ValueError("Could not find valid pre-fire or post-fire image. Try adjusting the date range.")

# Define bands for resampling
bands_10m = ['B2', 'B3', 'B4', 'B8']  # Native 10m resolution
bands_20m = ['B5', 'B6', 'B7', 'B8A', 'B11', 'B12']  # Resample to 10m

# Function to process Sentinel-2 images (resampling + scaling)
def process_image(image):
    reference_proj = image.select('B8').projection()
    resampled_bands = image.select(bands_20m).resample('bilinear')
    merged = image.select(bands_10m).addBands(resampled_bands)
    scaled = merged.divide(10000)  # Convert to reflectance scale
    return scaled.copyProperties(image, image.propertyNames())

# Apply processing to both pre-fire and post-fire images
preFireProcessed = preFireImage.map(process_image).median().clip(AOI8)
postFireProcessed = postFireImage.map(process_image).median().clip(AOI8)

# Ensure preFireProcessed and postFireProcessed are valid ee.Images before reprojecting
if not isinstance(preFireProcessed, ee.Image) or not isinstance(postFireProcessed, ee.Image):
    raise TypeError("Expected ee.Image but found ee.Element. Check process_image() return type.")

# **Final step: Enforce uniform 10m resolution**
final_prefire = preFireProcessed.reproject(
    crs=preFireProcessed.select('B8').projection(),
    scale=10
)

final_postfire = postFireProcessed.reproject(
    crs=postFireProcessed.select('B8').projection(),
    scale=10
)

# Load and filter the MODIS ImageCollection
modisdataset = ee.ImageCollection("MODIS/061/MCD12Q1") \
    .filterBounds(AOI8) \
    .filterDate("2019-01-01", "2019-12-31") \
    .select('LC_Type1')

# Get the first image and clip to AOI
landCoverImage = modisdataset.first().clip(AOI8)

# Step 1: Reproject the original image
reprojectedImage = landCoverImage.reproject(
    crs='EPSG:4326',
    scale=463.312716525
)

# Add a constant band for reducer mode to work
constant_band = ee.Image.constant(1).rename('constant')

# Combine the land cover image with the constant band
image_with_constant = reprojectedImage.addBands(constant_band)

# Perform vectorization using reduceToVectors with mode reducer
vectors = image_with_constant.reduceToVectors(
    reducer=ee.Reducer.mode(),
    geometry=AOI8.geometry(),
    scale=10,
    maxPixels=1e13,
    tileScale=4
)

# Print the result
print("Vectorization complete.")

# Step 3: Mask out classes from 10 to 17
maskFilter = ee.Filter.And(
    ee.Filter.gte('label', 10),
    ee.Filter.lte('label', 17)
)
maskedVectors = vectors.filter(maskFilter)

# Convert the masked vectors to a raster image
maskImage = maskedVectors.reduceToImage(properties=['mode'], reducer=ee.Reducer.first()) \
    .unmask(0).neq(1)

#Apply LULC Mask to both pre and post-fire images
preFireMaskedFinal = final_prefire.updateMask(maskImage)
postFireMaskedFinal = final_postfire.updateMask(maskImage)

print("✅ Pre-fire and Post-fire TCC layers with LULC mask visualized successfully!")

# Function to compute indices
def addIndices(image):
    b8 = image.select('B8')   # NIR
    b4 = image.select('B4')   # Red
    b3 = image.select('B3')   # Green
    b5 = image.select('B5').resample('bilinear')   # Red Edge 1
    b7 = image.select('B7').resample('bilinear')   # Red Edge 3
    b8a = image.select('B8A').resample('bilinear') # Red Edge 4
    b12 = image.select('B12').resample('bilinear') # SWIR 2

    # Compute vegetation and burn indices
    ndvi = b8.subtract(b4).divide(b8.add(b4)).rename('NDVI')
    nbr = b8.subtract(b12).divide(b8.add(b12)).rename('NBR')
    gndvi = b8.subtract(b3).divide(b8.add(b3)).rename('GNDVI')
    ndvire1 = b8.subtract(b5).divide(b8.add(b5)).rename('NDVIre1')
    ndvire1n = b8a.subtract(b5).divide(b8a.add(b5)).rename('NDVIre1n')
    clre = (b7.divide(b5).subtract(1)).rename('Clre')

    return image.addBands([ndvi, gndvi, nbr, clre, ndvire1, ndvire1n])

# Compute indices for pre-fire and post-fire images
preFireIndices = addIndices(preFireMaskedFinal)
postFireIndices = addIndices(postFireMaskedFinal)

# Function to compute delta indices
def computeDeltaIndices():
    deltaNDVI = preFireIndices.select('NDVI').subtract(postFireIndices.select('NDVI')).rename('DeltaNDVI')
    deltaNBR = preFireIndices.select('NBR').subtract(postFireIndices.select('NBR')).rename('DeltaNBR')
    deltaGNDVI = preFireIndices.select('GNDVI').subtract(postFireIndices.select('GNDVI')).rename('DeltaGNDVI')
    deltaNDVIre1 = preFireIndices.select('NDVIre1').subtract(postFireIndices.select('NDVIre1')).rename('DeltaNDVIre1')
    deltaNDVIre1n = preFireIndices.select('NDVIre1n').subtract(postFireIndices.select('NDVIre1n')).rename('DeltaNDVIre1n')
    deltaClre = preFireIndices.select('Clre').subtract(postFireIndices.select('Clre')).rename('DeltaClre')

    return ee.Image.cat([deltaNDVI, deltaNBR, deltaGNDVI, deltaNDVIre1, deltaNDVIre1n, deltaClre])

# Compute the delta indices
deltaIndices = computeDeltaIndices()

print("🔥 Delta indices visualized successfully!")

# Export function for Google Drive
def export_to_drive(image, index_name, description, folder='DeltaIndicesTest_Meghalaya_EGH_March2019', scale=10):
    task = ee.batch.Export.image.toDrive(
        image=image,
        description=description,
        folder=folder,
        fileNamePrefix=f"{index_name}_Meghalaya_EGH_March2019",
        region=AOI8.geometry().bounds(),
        scale=scale,
        crs='EPSG:4326',
        maxPixels=1e13
    )
    task.start()
    print(f"Export task started for {index_name}")

# Export each index layer
index_names = ['DeltaNDVI', 'DeltaGNDVI', 'DeltaNBR', 'DeltaClre', 'DeltaNDVIre1', 'DeltaNDVIre1n']
for index_name in index_names:
    index_image = deltaIndices.select(index_name)
    export_to_drive(index_image, index_name, f'Export_{index_name}_Meghalaya_EGH_March2019')

# Visualize using geemap
m = geemap.Map()
m.centerObject(AOI8, zoom=10)  # Centers on AOI8 with zoom level 10
m.addLayer(AOI8.style(color='black', fillColor='00000000'), {}, 'AOI')
m.addLayer(landCoverImage, {'min': 1, 'max': 17,
                               'palette': ['05450a', '086a10', '54a708', '78d203',
                                           '009900', 'c6b044', 'dcd159', 'dade48',
                                           'fbff13', 'b6ff05', '27ff87', 'c24f44',
                                           'a5a5a5', 'ff6d4c', '69fff8', 'f9ffa4',
                                           '1c0dff']}, 'Reprojected MODIS')
m.addLayer(maskedVectors.style(color='blue', width=1), {}, 'Masked Classes (10-17)')
m.addLayer(preFireMaskedFinal, {'bands': ['B4', 'B3', 'B2'], 'min': 0, 'max': 0.3}, 'Masked preFireSentinel-2')
m.addLayer(postFireMaskedFinal, {'bands': ['B4', 'B3', 'B2'], 'min': 0, 'max': 0.3}, 'Masked postFireSentinel-2')

visParams = {
    'DeltaNDVI': {'min': -1, 'max': 1, 'palette': ['red', 'white', 'green']},
    'DeltaNBR': {'min': -1, 'max': 1, 'palette': ['blue', 'white', 'green']},
    'DeltaGNDVI': {'min': -1, 'max': 1, 'palette': ['yellow', 'white', 'green']},
    'DeltaNDVIre1': {'min': -1, 'max': 1, 'palette': ['purple', 'white', 'blue']},
    'DeltaNDVIre1n': {'min': -1, 'max': 1, 'palette': ['orange', 'white', 'green']},
    'DeltaClre': {'min': -1, 'max': 15, 'palette': ['white', 'blue', 'purple']},
}

for index, params in visParams.items():
    m.addLayer(deltaIndices.select(index), params, index)

m.addLayerControl()
m

